# -----------------------------------------------------------------------
# HuggingFace token — needed by download_models.sh
# -----------------------------------------------------------------------
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------
# llama-server endpoints (only change if you use non-default ports)
# -----------------------------------------------------------------------
LLM_BASELINE_URL=http://localhost:8000/v1
LLM_SPECULATIVE_URL=http://localhost:8001/v1

# -----------------------------------------------------------------------
# GGUF file paths — set by download_models.sh, or fill in manually
# Example paths shown for E4B (default)
# -----------------------------------------------------------------------
TARGET_MODEL_GGUF=/path/to/models/gemma-4-E4B-it-Q8_0.gguf
DRAFT_MODEL_GGUF=/path/to/models/gemma-4-E4B-it-assistant-F16.gguf

# -----------------------------------------------------------------------
# Model alias — must match --alias in the server scripts
# This is what the pipeline sends as the "model" field in API requests
# -----------------------------------------------------------------------
MODEL_ALIAS=gemma-4-e4b-it
TARGET_MODEL=gemma-4-e4b-it

# -----------------------------------------------------------------------
# Server tuning (optional — defaults used if not set)
# -----------------------------------------------------------------------
# CONTEXT_LEN=4096
# N_GPU_LAYERS=-1        # -1 = offload all layers to GPU
# NUM_DRAFT_TOKENS=4

# -----------------------------------------------------------------------
# Arize Phoenix observability (Phase 5)
# Spans carry session.id so traces are filterable per session in Phoenix.
#   PHOENIX_EXTERNAL=true  → connect to an already-running Phoenix collector
#                            (no local px.launch_app()).
#   PHOENIX_EXTERNAL=false → launch a local Phoenix server on first run.
#   MISSIONS_API_TELEMETRY → emit spans for API/frontend-launched runs
#                            (default true; set false to opt out, e.g. tests).
# -----------------------------------------------------------------------
PHOENIX_HOST=127.0.0.1
PHOENIX_PORT=6006
PHOENIX_EXTERNAL=false
MISSIONS_API_TELEMETRY=true

# -----------------------------------------------------------------------
# Model registry (Phase 11) — per-role model + thinking from backend choice
# Frontend selects local | gemini | gpt4o | auto; runtime resolves per role.
# -----------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_THINKING_LEVEL_DEFAULT=minimal
GEMINI_THINKING_LEVEL_MAX=medium

OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o
OPENAI_LLM_MODEL_ENRICHMENT=gpt-4o-mini

# -----------------------------------------------------------------------
# Session evals (Phase 6)
#   MISSIONS_AUTO_EVAL          — run evals after mission.complete (default false)
#   MISSIONS_EVAL_LLM_JUDGE     — include harness LLM-as-judge evaluators
#   MISSIONS_EVAL_PHOENIX_EXPORT — export eval spans to Phoenix OTel
# Phoenix also ships arize-phoenix-evals for trace-level LLM judges in the UI;
# harness evals here are mission-specific and complement that layer.
# -----------------------------------------------------------------------
MISSIONS_AUTO_EVAL=false
MISSIONS_EVAL_LLM_JUDGE=false
MISSIONS_EVAL_PHOENIX_EXPORT=true
