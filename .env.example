# Copy this file to .env and fill in your values.
# The .env file is gitignored and never committed.

# HuggingFace token (required to download gated Gemma 4 models).
# Accept the license at https://huggingface.co/google/gemma-4-E4B-it first,
# then create a read token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# vLLM server endpoints (only change if you use non-default ports)
VLLM_BASELINE_URL=http://localhost:8000/v1
VLLM_SPECULATIVE_URL=http://localhost:8001/v1

# Target and draft model IDs (match the vLLM server --model flags)
TARGET_MODEL=google/gemma-4-E4B-it
DRAFT_MODEL=google/gemma-4-E4B-it-assistant
