# HuggingFace token — needed by download_models.sh
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# llama-server endpoints (only change if you use non-default ports)
LLM_BASELINE_URL=http://localhost:8000/v1
LLM_SPECULATIVE_URL=http://localhost:8001/v1

# GGUF file paths — set by download_models.sh, 
TARGET_MODEL_GGUF=<model-path>.gguf
# if gemma 4
#DRAFT_MODEL_GGUF=<assistant-model-path>.gguf

MODEL_ALIAS=qwen3.6-27b-mtp
TARGET_MODEL=qwen3.6-27b-mtp


PHOENIX_HOST=127.0.0.1
PHOENIX_PORT=6006
PHOENIX_EXTERNAL=false
MISSIONS_API_TELEMETRY=true


# Model registry (Phase 11) — per-role model + thinking from backend choice
# Frontend selects local | gemini | gpt4o | auto; runtime resolves per role.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_THINKING_LEVEL_DEFAULT=minimal
GEMINI_THINKING_LEVEL_MAX=medium

OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o
OPENAI_LLM_MODEL_ENRICHMENT=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMS=738

# Qdrant db
QDRANT_URL=<qdrant-url>
QDRANT_API_KEY=<qdrant-api-key>
QDRANT_COLLECTION=agent_skills
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_SPARSE_VECTOR_NAME=sparse
QDRANT_DENSE_VECTOR_DIMS=768

#Cognee Specific (only needed when MISSIONS_MEMORY_BACKEND=cognee)
LLM_API_KEY=<openai-api-key>
LLM_PROVIDER=openai

# Arize Endpoints
PHOENIX_HOST=http://127.0.0.1
PHOENIX_PORT=6006
PHOENIX_EXTERNAL=true
MISSIONS_API_TELEMETRY=true
MISSIONS_AUTO_EVAL=false
MISSIONS_EVAL_LLM_JUDGE=false
MISSIONS_EVAL_PHOENIX_EXPORT=true


# LLM Parameters
# Per-role sampling: tool-calling/code-gen needs near-deterministic decoding.
# Precedence: LLM_TEMPERATURE_<ROLE> > LLM_TEMPERATURE > built-in role default.
LLM_TEMPERATURE_WORKER=0.5
LLM_TEMPERATURE_ORCHESTRATOR=0.8
LLM_TEMPERATURE_VALIDATOR=0.6
LLM_TOP_P=0.95
LLM_SEED=42

# Per-role completion budgets (tokens)
MAX_TOKENS_WORKER=12288
MAX_TOKENS_ORCHESTRATOR=24576
MAX_TOKENS_VALIDATOR=16384

# Worker protocol
MAX_WORKER_BATCH_CALLS=3
MAX_WORKER_HISTORY_TURNS=40
WORKER_CONTRACT_AUTORUN_MAX=8

# Tool-call circuit breakers
MAX_SAME_TOOL_FAILURES=2
MAX_CONSECUTIVE_TOOL_FAILURES=5

# Replan circuit breaker
MAX_REPLANS_PER_MILESTONE=2

# Local thinking levels (llama.cpp understands only on/off; any non-"off"
# value means enabled). Measured on Qwen3.6-27B: orchestrator medium thinking
# is ~80% of mission wall-clock. Try "off" for speed, "medium" for plan quality.
#LOCAL_THINKING_LEVEL_ORCHESTRATOR=medium
#LOCAL_THINKING_LEVEL_VALIDATOR=medium

# Memory backend: json (default, zero latency) | cognee (opt-in, adds cloud
# LLM graph-extraction cost; writes are fire-and-forget when enabled)
MISSIONS_MEMORY_BACKEND=json

LOG_LEVEL=ERROR

SANDBOX_EXECUTOR=auto
SANDBOX_MODE=balanced