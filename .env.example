# -----------------------------------------------------------------------
# HuggingFace token — needed by download_models.sh
# -----------------------------------------------------------------------
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------
# llama-server endpoints (only change if you use non-default ports)
# -----------------------------------------------------------------------
LLM_BASELINE_URL=http://localhost:8000/v1
LLM_SPECULATIVE_URL=http://localhost:8001/v1

# -----------------------------------------------------------------------
# GGUF file paths — set by download_models.sh, or fill in manually
# Example paths shown for E4B (default)
# -----------------------------------------------------------------------
TARGET_MODEL_GGUF=/path/to/models/gemma-4-E4B-it-Q8_0.gguf
DRAFT_MODEL_GGUF=/path/to/models/gemma-4-E4B-it-assistant-F16.gguf

# -----------------------------------------------------------------------
# Model alias — must match --alias in the server scripts
# This is what the pipeline sends as the "model" field in API requests
# -----------------------------------------------------------------------
MODEL_ALIAS=gemma-4-e4b-it
TARGET_MODEL=gemma-4-e4b-it

# -----------------------------------------------------------------------
# Server tuning (optional — defaults used if not set)
# -----------------------------------------------------------------------
# CONTEXT_LEN=4096
# N_GPU_LAYERS=-1        # -1 = offload all layers to GPU
# NUM_DRAFT_TOKENS=4
